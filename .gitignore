workbench/tmp/

# Episode media policy:
# all image/video/audio/archive binaries below episodes/ remain LOCAL ONLY.
# Git tracks story/meta/code; pixel assets are linked by SHA/media-index.
episodes/**/*.png
episodes/**/*.jpg
episodes/**/*.jpeg
episodes/**/*.gif
episodes/**/*.webp
episodes/**/*.bmp
episodes/**/*.ico
episodes/**/*.tif
episodes/**/*.tiff
episodes/**/*.svg
episodes/**/*.mp4
episodes/**/*.mov
episodes/**/*.avi
episodes/**/*.mkv
episodes/**/*.wav
episodes/**/*.mp3
episodes/**/*.flac
episodes/**/*.zip

# Explicit exception: character anchors are allowed in Git.
!episodes/**/assets/characters/**

# research/competitors/** and research/account/** are intentionally not ignored.

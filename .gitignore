# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Story OS / Codex transient runtime homes and helper scripts
.tmp-codex-critic-home/
_tmp_*
episodes/_system/_tmp_*

# Story OS high-volume raw runtime logs are local/derived evidence.
# Formal review JSON and SHA-bound critic evidence remain trackable.
episodes/**/meta/image-workers/
episodes/**/meta/rolling-review-workers/
episodes/**/meta/scoped-workers/
episodes/**/meta/codex-auto-run.jsonl
episodes/**/meta/runtime/trace-events.jsonl
episodes/**/meta/workflow-run.jsonl

# Python build artifacts
__pycache__/
*.pyc

# Codex tool output
.codex/
.playwright-cli/
.codex-review/

# Story OS local install / backup / migration state
.story-os-v*installed.json
.story-upgrade-backups/
.story-os-upgrade-backups/
.story-os-backups/
.story-os-*-backups/
.story-os-history/
.story-os-media-migration/
.story-os-media-inventory.json
.storyos_backups/

# Episode meta intermediate review candidates (formal evidence lives in final files)
episodes/**/meta/.*.candidate.json

# Local opt-out marker for reference/image sets that live under episodes/ but are not Episodes.
# Canonical discovery still requires meta/episode-state.json and excludes _system/_tests.
episodes/**/.storyos-non-episode.json

# Story OS local virtualenv / upgrade packages
.story-os-venv/
Story_OS_V2.0_OneClick_FullAuto_Upgrade_UTF8_FINAL/
DaliCat_StoryOS_*/
Story_OS_V2.0.2_Production_Closure_OneClick_Upgrade_UTF8_FINAL/
DaliCat_StoryOS_V2.0.3.2_CreativeEnforcement_RootSafe_R3/
Story_OS_V2.1_*/
storyos_*/
StoryOS_*_Hotfix.py

# Local workbench
workbench/tmp/

# Episode media policy:
# all image/video/audio/archive binaries below episodes/ remain LOCAL ONLY.
# Git tracks story/meta/code; pixel assets are linked by SHA/media-index.
episodes/**/media/
episodes/**/*.png
episodes/**/*.jpg
episodes/**/*.jpeg
episodes/**/*.gif
episodes/**/*.webp
episodes/**/*.bmp
episodes/**/*.ico
episodes/**/*.tif
episodes/**/*.tiff
episodes/**/*.svg
episodes/**/*.mp4
episodes/**/*.mov
episodes/**/*.avi
episodes/**/*.mkv
episodes/**/*.wav
episodes/**/*.mp3
episodes/**/*.flac
episodes/**/*.zip

# Explicit exception: character anchors are allowed in Git.
!episodes/**/assets/characters/**

# research/competitors/** and research/account/** are intentionally not ignored.

# Story OS R2 runtime cache
.storyos_cache/

# Story OS dot-directory local install evidence
.storyos/backups/
.storyos/history/

ensity=high; retain causal incidental clutter\\npractical available light=True; no invented cinematic key/rim lighting\\ncomposition=unposed_imperfect_personal_record\\npeople=ordinary_unprepared_not_actor_like\\ncolor=environment_driven_low_to_medium_saturation\\ntexture=causal_controlled_imperfection\\nanomaly=embedded_in_reality_before_spectacle\\nforbid commercial HDR, promo polish, default portrait bokeh, heroic framing and causeless retro/noise effects\\ncapture physics and story era override texture; never fake an old device when the story uses a modern phone\\n\\n[CAPTURE / AUTHENTICITY]\\n{\\\"aspect_ratio\\\":\\\"4:5\\\",\\\"camera_rules\\\":{\\\"current_device_may_be_fully_visible\\\":false,\\\"current_device_visibility_explanation\\\":\\\"当前拍摄手机不完整入镜\\\",\\\"photographer_may_be_fully_visible\\\":false,\\\"photographer_visibility_explanation\\\":\\\"第一人称，仅自然露肢体局部，不出现无来源第三人称正脸\\\"},\\\"capture_states\\\":{\\\"lost_control\\\":\\\"图15-18热风与快速撤离时手持更不稳，但关键尺度参照与巨物轮廓仍必须清楚\\\",\\\"restricted\\\":\\\"停电后依靠车灯/手机手电，背景掉黑、高ISO与轻运动模糊只在物理需要时出现\\\",\\\"stable\\\":\\\"停电前普通手机夜景；可读、轻微手持偏斜、无商业HDR\\\"},\\\"location\\\":\\\"中国西北虚构普通县城槐川县；不影射真实灾害或政府事件\\\",\\\"photographer\\\":\\\"24岁男性主角 P01，第一人称记录\\\",\\\"primary_capture\\\":{\\\"device\\\":\\\"2026年前后普通智能手机，手持竖拍，默认4:5裁切/构图\\\",\\\"id\\\":\\\"CP01\\\"},\\\"secondary_captures\\\":[],\\\"secondary_source_explanation\\\":\\\"无第二拍摄源\\\",\\\"shooting_reason\\\":\\\"返乡途中手机随手记录极端高温、突然停电和随后出现的县城显形异常\\\",\\\"story_era\\\":\\\"2026年仲夏\\\"}\\n\\n[CHARACTER / POV CONTRACT]\\n{\\\"cast\\\":{\\\"members\\\":[{\\\"age\\\":24,\\\"build\\\":\\\"普通年轻人体型\\\",\\\"clothing_anchor\\\":\\\"黑色短袖+深灰工装裤+普通运动鞋\\\",\\\"device_anchor\\\":\\\"普通智能手机\\\",\\\"gender\\\":\\\"male\\\",\\\"hair\\\":\\\"普通黑色短发，略被汗打湿\\\",\\\"id\\\":\\\"P01\\\",\\\"pov\\\":true}],\\\"relationship\\\":\\\"单人\\\",\\\"size\\\":1,\\\"type\\\":\\\"single_male\\\"},\\\"continuity_policy\\\":{\\\"clothing_and_device_anchors_propagate_to_frame_contract\\\":true,\\\"member_count_changes_require_story_event\\\":true,\\\"pov_character_id_stable\\\":true},\\\"created_at\\\":\\\"2026-08-31T14:20:00+08:00\\\",\\\"derived_from_pools\\\":true,\\\"entry\\\":{\\\"label\\\":\\\"回家/回老家\\\",\\\"reason\\\":\\\"在外地工作的普通年轻人请了两天假，夜里返乡参加第二天发小的婚礼；停电后从县城客运站步行回家\\\",\\\"source\\\":\\\"story_os_selection\\\",\\\"type\\\":\\\"return_home\\\"},\\\"era\\\":{\\\"bucket\\\":\\\"modern_2020s\\\",\\\"source\\\":\\\"story_os_selection\\\",\\\"year\\\":2026},\\\"forbidden_role_check\\\":{\\\"hits\\\":[],\\\"pass\\\":true},\\\"locked_at\\\":\\\"2026-08-31T14:20:00+08:00\\\",\\\"no_anomaly_test\\\":{\\\"must_be_rechecked_before_story_lock\\\":true,\\\"ordinary_day_plan\\\":\\\"夜班客车到县城后步行或打车回家，洗澡睡觉，第二天参加发小婚礼；高温和临时停电只会让返家更麻烦。\\\",\\\"pass\\\":true,\\\"question\\\":\\\"如果删掉所有异常，这一天是否仍像真实生活？\\\",\\\"rechecked_against_final_story\\\":true},\\\"not_episode_stage\\\":true,\\\"ordinary_person_score\\\":100,\\\"pov\\\":{\\\"character_id\\\":\\\"P01\\\",\\\"first_person\\\":true},\\\"role_policy\\\":{\\\"career_function\\\":\\\"none\\\",\\\"protagonist_role\\\":\\\"普通年轻人\\\",\\\"solves_anomaly_professionally\\\":false},\\\"scene\\\":{\\\"primary_category\\\":\\\"county_town\\\",\\\"primary_place\\\":\\\"中国西北虚构县城“槐川县”的客运站—老商业街—步行天桥—普通住宅小区\\\"},\\\"schema_version\\\":1,\\\"selection_seed\\\":202608311101,\\\"status\\\":\\\"LOCKED\\\",\\\"story_build_note\\\":\\\"Story Lock 已复核：主角没有专业异常处理职能；返乡动机在删除全部异常后仍成立。\\\"}\\n\\n[WORLD IDENTITY NOT APPLICABLE]\\n\\n\\n[CHARACTER APPEARANCE ANCHOR NOT APPLICABLE]\\n\\n\\n[CONTINUITY]\\n{\\\"anchors\\\":{\\\"anomaly_material\\\":\\\"县城本身是垂死巨物：表皮极薄半透明且边缘甲片分层，携带颜色/反光/标线等表面信息；表皮下是暗灰粗糙带浅骨板纹理的躯体表面，门窗接口错位；山脊=卧兽背脊，路灯杆=须，楼群=鳞甲\\\",\\\"location\\\":\\\"槐川县空间链：客运站→老商业街→十字路口→河渠步道→步行天桥→普通住宅小区\\\",\\\"protagonist\\\":\\\"P01 周启明，24岁男性第一人称；黑短发；黑短袖+深灰工装裤+普通运动鞋；只自然露手臂/裤腿/鞋等局部\\\",\\\"weather_time\\\":\\\"仲夏极热夜，22:42抵达，23:03停电，23:51高潮，00:06复电，次日上午残留\\\"},\\\"required\\\":[\\\"protagonist\\\",\\\"location\\\",\\\"weather_time\\\",\\\"anomaly_material\\\"]}\\n\\n[ENVIRONMENT PHYSICS]\\n{\\\"condition\\\":\\\"停电持续，间歇热风增强，巨物显形、县城表皮大范围被顶起\\\",\\\"conditional_effects\\\":[{\\\"effect\\\":\\\"薄层边缘在车灯或手机光下出现真实半透明反射\\\",\\\"when\\\":[\\\"薄层与局部光源夹角合适\\\"]}],\\\"ground_state\\\":\\\"干燥沥青与水泥路面，白天积热未散\\\",\\\"physical_cues\\\":[\\\"热风让悬空薄层出现方向一致的张力和褶皱\\\",\\\"车辆/楼层/路灯提供稳定尺度\\\",\\\"手机夜拍高光不过度扩展\\\",\\\"山脊卧兽轮廓逐级隆起（03/10/13/16/17）\\\"],\\\"precipitation\\\":\\\"无\\\",\\\"temperature_feel\\\":\\\"白天约40℃后的积热仍明显，夜间体感约31℃，空气干热闷滞\\\",\\\"time_of_day\\\":\\\"22:42-00:10 夜间\\\",\\\"visibility\\\":\\\"停电前普通县城夜景；停电后依靠车灯、手机和极少应急光\\\",\\\"wind\\\":\\\"较强间歇热风，巨物表皮被向上托起但楼体/车辆本身不漂浮\\\"}\\n\\n[CAPTURE EVENT]\\n{}\\n\\n[PERSISTENT WORLD STATE]\\n{}\\n\\n[CHARACTER VISUAL / ORIGINAL IDENTITY]\\n{\\\"created_at\\\":\\\"2026-08-31T19:40:19+08:00\\\",\\\"lock_model\\\":\\\"identity_spec__provisional_baseline_master__final_visual_lock_master\\\",\\\"master_policy\\\":{\\\"crop_manifest_artifact\\\":\\\"meta/character-master-crops.json\\\",\\\"derived_crops_are_not_new_identity_generation\\\":true,\\\"final_master_after_four_admission_pass\\\":true,\\\"ordinary_baseline_can_become_group_identity_master\\\":true,\\\"pixel_master_artifact\\\":\\\"meta/character-pixel-master.json\\\",\\\"preferred_identity_source\\\":[\\\"character_individual_crop\\\",\\\"character_pixel_master\\\",\\\"ordinary_baseline_group_selfie\\\",\\\"original_character_library_asset\\\"],\\\"preproduction_only_must_not_generate_master_images\\\":true,\\\"provisional_master_after_baseline_review_pass\\\":true},\\\"members\\\":{\\\"P01\\\":{\\\"attractiveness\\\":\\\"moderately_above_average_but_real\\\",\\\"body_build\\\":\\\"lean_proportionate_natural\\\",\\\"body_build_story_override_reason\\\":\\\"\\\",\\\"face_identity\\\":{\\\"celebrity_likeness\\\":false,\\\"fashion_model_styling\\\":false,\\\"identity_spec_locked\\\":false,\\\"independently_distinct_face\\\":true,\\\"influencer_face\\\":false,\\\"original_character\\\":true,\\\"reference_similarity_target\\\":\\\"low\\\",\\\"skin_texture\\\":\\
ugin_connector_1p_1a69035c238881919c4190932b2df699\",\"name\":\"plugin_connector_1p_1a69035c238881919c4190932b2df699\",\"title\":\"GitHub\",\"description\":\"Inspect repositories, triage pull requests and issues, debug CI, and publish changes through a hybrid GitHub connector and CLI workflow.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_1a69035c238881919c4190932b2df699\",\"plugin_name\":\"github\",\"plugin_release_id\":\"pluginrel_6a90d44e3d248191a661e26ffba27931\",\"plugin_release_version\":\"0.1.12-5f7cd798dc99\",\"apps\":[\"app://connector_76869538009648d5b282a4bb21c3d157\"],\"skills\":[],\"requires_executor\":false,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_1a69035c238881919c4190932b2df699/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"title\":\"Plugin Management\",\"description\":\"Discover relevant plugins and manage app connections, permissions, and dependencies.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_version\":\"0.1.0\",\"apps\":[\"app://connector_openai_plugin_management\"],\"skills\":[\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\"],\"requires_executor\":false,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://Plugin_fa77aec24fc08191bc6e57f377126d76\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"title\":\"Product Design\",\"description\":\"The Product Design plugin is built for turning early ideas into prototypes teams can review. It starts design and build work by confirming the brief, then helps teams explore product directions, audit user flows, prototype from a live URL, and make static screenshots interactive.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_version\":\"0.1.53\",\"apps\":[],\"skills\":[\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/audit\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/design-qa\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/get-context\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/ideate\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/image-to-code\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/index\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/research\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/share\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/url-to-code\",\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/user-context\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://Plugin_fa77aec24fc08191bc6e57f377126d76/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"title\":\"Sites\",\"description\":\"Build and deploy websites with Sites. Use of Sites is subject to the ChatGPT Sites Terms (https://openai.com/policies/chatgpt-sites-terms/), and you are responsible for your website content.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6a991963b398819196cc6712d9be8a00\",\"plugin_release_version\":\"0.1.49\",\"apps\":[\"app://connector_20205bf7d4e99a89d7154bb849718324\"],\"skills\":[\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-building\",\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-hosting\",\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-preview-troubleshooting\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-batch-edit-photos\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-batch-edit-photos\",\"title\":\"Batch edit photos\",\"description\":\"Apply consistent photo adjustments across a set of images so they look like they were edited together. Use this skill whenever the user says \\\"make my photos look cohesive\\\", \\\"give all these the same style\\\", \\\"apply a warm and golden feel to all of these\\\", \\\"make this cinematic\\\", \\\"match the look across my photos\\\", \\\"edit all my travel photos the same way\\\", \\\"batch edit these\\\", \\\"make these consistent\\\", \\\"fix my phone photos\\\", or uploads a folder of photos and wants a unified, polished result. Also triggers for requests like \\\"apply a preset to all of these\\\", \\\"make these look professional\\\", or \\\"they were shot in mixed lighting — can you fix them all\\\". Outputs direct final image URLs plus an in-chat preview grid and optional Firefly Board link. Access: 🔐 Signed-In required | Gen AI: ❌\\n\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_name\":\"app-69312da8e4dc81919370cb86fd172b6c\",\"plugin_release_id\":\"pluginrel_2cfc244057c881919bcc14373ac93649\",\"plugin_release_skill_id\":\"pluginrsk_6a7df79ca6c0819191ddba6797540aac\",\"skill_name\":\"adobe-batch-edit-photos\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-create-mockups\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-create-mockups\",\"title\":\"Create mockups\",\"description\":\"Use when a user wants to see their logo, design, or sketch on a product or scene mockup — mugs, t-shirts, business cards, hats, phone screens, posters, billboards, or similar. Triggers on \\\"create mockups\\\", \\\"show my logo on products\\\", or any logo upload with a request to visualize it on items. Access: 🔐 Signed-In required | Gen AI: ✅ Adobe Firefly via `image_generate` used for design creation, sketch polishing, and mockup scene generation\\n\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_name\":\"app-69312da8e4dc81919370cb86fd172b6c\",\"plugin_release_id\":\"pluginrel_2cfc244057c881919bcc14373ac93649\",\"plugin_release_skill_id\":\"pluginrsk_6a7df79cb18881918e7bd8a214954ee7\",\"skill_name\":\"adobe-create-mockups\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-create-social-variations\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-create-social-variations\",\"title\":\"Create social variations\",\"description\":\"Resize, crop, or export any image or video into platform-ready social media assets using Adobe Creative Cloud tools. Use this skill when a user wants to prepare a photo, image, or video for one or more social platforms — Instagram, TikTok, LinkedIn, Facebook, YouTube, Snapchat, Pinterest, Threads, or X/Twitter. Triggers on: \\\"prepare my image for Instagram\\\", \\\"resize for TikTok\\\", \\\"get this ready to post\\\", \\\"make versions for all platforms\\\", \\\"social media sizes\\\", \\\"crop for stories\\\", \\\"export for LinkedIn\\\", \\\"resize my video for social\\\", \\\"make social media assets\\\", or any request to adapt a photo or video for specific platforms. Handles subject-aware cropping, AI canvas expansion, test previews before full runs, and same-ratio video resizing.\\n\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_name\":\"app-69312da8e4dc81919370cb86fd172b6c\",\"plugin_release_id\":\"pluginrel_2cfc244057c881919bcc14373ac93649\",\"plugin_release_skill_id\":\"pluginrsk_6a7df79cbae081919e6b432202ec5f14\",\"skill_name\":\"adobe-create-social-variations\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-design-from-template\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-design-from-template\",\"title\":\"Design from template\",\"description\":\"Create any visual design using Adobe Express templates — flyers, posters, social media posts (Instagram, Facebook, LinkedIn), business cards, invitations, greeting cards, resumes, cover letters, brochures, newsletters, certificates, presentations, YouTube thumbnails, email headers, logos, menus, and labels. Use this skill whenever the user wants to make, design, or build any visual — even if they just say \\\"make me a flyer\\\", \\\"design a poster\\\", \\\"I need something for Instagram\\\", \\\"create an event invite\\\", or \\\"make a business card\\\". Also handles browsing templates, editing text, replacing images, changing backgrounds, animating, and exporting designs. Access: 🔐 Signed-In required | Gen AI: ❌ by default — image replacement only where the surface permits generative AI (e.g. Codex); none on Claude\\n\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_name\":\"app-69312da8e4dc81919370cb86fd172b6c\",\"plugin_release_id\":\"pluginrel_2cfc244057c881919bcc14373ac93649\",\"plugin_release_skill_id\":\"pluginrsk_6a7df79cc4a081919008e483adda5124\",\"skill_name\":\"adobe-design-from-template\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-edit-quick-cut\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-edit-quick-cut\",\"title\":\"Edit quick cut\",\"description\":\"Create a punchy sizzle reel from a video using Adobe Quick Cut. Use this skill whenever a user wants to cut, trim, or shorten a video into highlights — including phrases like \\\"make a sizzle reel\\\", \\\"make a highlight reel\\\", \\\"quick cut this\\\", \\\"cut the best parts\\\", \\\"shorten this video\\\", \\\"make a highlight clip\\\", \\\"summarize this video visually\\\", or any request to produce a shorter edited version of a video. Use this skill for Quick Cut requests before suggesting manual editing in Premiere. Requires the user to upload a video file.\\n\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c\",\"plugin_name\":\"app-69312da8e4dc81919370cb86fd172b6c\",\"plugin_release_id\":\"pluginrel_2cfc244057c881919bcc14373ac93649\",\"plugin_release_skill_id\":\"pluginrsk_6a7df79cceb48191bcf17f704ac9535c\",\"skill_name\":\"adobe-edit-quick-cut\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-retouch-portraits\",\"name\":\"plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c/adobe-retouch-portraits…9441 tokens truncated…sks whether they have submitted.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_asdk_app_6a330a7730c081919892632d5baaec58\",\"plugin_name\":\"app-6a330a7730c081919892632d5baaec58\",\"plugin_release_id\":\"pluginrel_e715b3b616a08191908975b851e79f43\",\"plugin_release_skill_id\":\"pluginrsk_6edf4cdb6920819188dfd2cbfd4a171e\",\"skill_name\":\"submit-project\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-code-connect\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-code-connect\",\"title\":\"figma-code-connect\",\"description\":\"Creates and maintains Figma Code Connect template files that map Figma components to code snippets. Use when the user mentions Code Connect, Figma component mapping, design-to-code translation, or asks to create/update .figma.ts or .figma.js files.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20a0819194490a3e857989ff\",\"skill_name\":\"figma-code-connect\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-create-new-file\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-create-new-file\",\"title\":\"figma-create-new-file\",\"description\":\"**MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `create_new_file` tool call. NEVER call `create_new_file` directly without loading this skill first. Trigger whenever the user wants a new blank Figma file — a new design, FigJam, or Slides file — or when you need a fresh file before calling `use_figma`. Usage — /figma-create-new-file [editorType] [fileName] (e.g. /figma-create-new-file figjam My Whiteboard, /figma-create-new-file slides Q3 Review)\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20ac819192128c1a70ef31a3\",\"skill_name\":\"figma-create-new-file\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-design-to-code\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-design-to-code\",\"title\":\"figma-design-to-code\",\"description\":\"**MANDATORY prerequisite** — you MUST invoke this skill BEFORE calling the `get_design_context` Figma MCP tool. You MUST trigger this skill whenever the user wants to implement, build, port, or code up a Figma design as code. Example prompts (not exhaustive) are 'implement this Figma design', 'build this screen from Figma', 'turn this Figma into code', 'design to code'. This skill provides critical instructions and steps to the agent on how to correctly implement Figma designs in code and must NOT be skipped.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20b481919831d7a45c25214b\",\"skill_name\":\"figma-design-to-code\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-design\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-design\",\"title\":\"figma-generate-design\",\"description\":\"Use this skill alongside figma-use when the task involves translating an application page, view, or multi-section layout into Figma. Triggers: 'write to Figma', 'create in Figma from code', 'push page to Figma', 'take this app/page and build it in Figma', 'create a screen', 'build a landing page in Figma', 'update the Figma screen to match code', 'convert this modal/dialog/drawer/panel to Figma'. This is the preferred workflow skill whenever the user wants to build or update a full page, modal, dialog, drawer, sidebar, panel, or any composed multi-section view in Figma from code or a description. Discovers design system components, variables, and styles from Code Connect files, existing screens, and library search, then imports them and assembles views incrementally section-by-section using design system tokens instead of hardcoded values.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20bc8191a98c283410ae8dd9\",\"skill_name\":\"figma-generate-design\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-diagram\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-diagram\",\"title\":\"figma-generate-diagram\",\"description\":\"MANDATORY prerequisite — load this skill BEFORE every `generate_diagram` tool call. NEVER call `generate_diagram` directly without loading this skill first. Trigger whenever the user asks to create, generate, draw, render, sketch, or build a diagram — flowchart, architecture diagram, sequence diagram, ERD or entity-relationship diagram, state diagram or state machine, gantt chart, or timeline. Also trigger when the user mentions Mermaid syntax or wants a system architecture, decision tree, dependency graph, API call flow, auth handshake, schema, or pipeline visualized in FigJam. Routes to type-specific guidance, sets universal Mermaid constraints, and tells you when to use a different diagram type or skip the tool entirely (mindmaps, pie charts, class diagrams, etc.).\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20c08191a5e3afbe7f130811\",\"skill_name\":\"figma-generate-diagram\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-library\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-generate-library\",\"title\":\"figma-generate-library\",\"description\":\"Build or update a professional-grade design system in Figma from a codebase. Use when the user wants to create variables/tokens, build component libraries, create individual components with proper variant sets and variable bindings, set up theming (light/dark modes), document foundations, or reconcile gaps between code and Figma. Also use when the user asks to create or generate any component in Figma — even a single one — since components require proper variable foundations, variant states, and design token bindings to be production-quality. This skill teaches WHAT to build and in WHAT ORDER — it complements the `figma-use` skill which teaches HOW to call the Plugin API. Both skills should be loaded together.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20c88191b747b4e2528025c0\",\"skill_name\":\"figma-generate-library\",\"contents\":[\"references\",\"scripts\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-implement-motion\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-implement-motion\",\"title\":\"figma-implement-motion\",\"description\":\"Translates Figma motion and animations into production-ready application code. Use when implementing animation/motion from a Figma design — user mentions \\\"implement this motion\\\", \\\"add animation from Figma\\\", \\\"animate this component\\\", provides a Figma URL whose node is animated, or when `get_design_context` returns motion data or instructs you to call `get_motion_context`.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20d081919d84864d13d926c7\",\"skill_name\":\"figma-implement-motion\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-swiftui\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-swiftui\",\"title\":\"figma-swiftui\",\"description\":\"SwiftUI ↔ Figma translation. Use whenever the user mentions Swift, SwiftUI, iOS, iPhone, or iPad — in EITHER direction — translating a Figma design into SwiftUI (design → code), or pushing SwiftUI views / screens / tokens back into a Figma file (code → design). Triggers on phrases like 'implement this Figma design in SwiftUI', 'build this screen in Swift', 'push this SwiftUI view to Figma', 'mirror my Swift code in a Figma file', or whenever a Figma URL appears alongside `.swift` files / an `.xcodeproj`. Routes to a direction-specific reference doc; loads alongside `figma-use` for the code → design path.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20d48191818b43dd7a29defc\",\"skill_name\":\"figma-swiftui\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use\",\"title\":\"figma-use\",\"description\":\"**MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `use_figma` tool call. NEVER call `use_figma` directly without loading this skill first. Skipping it causes common, hard-to-debug failures. Trigger whenever the user wants to perform a write action or a unique read action that requires JavaScript execution in the Figma file context — e.g. create/edit/delete nodes, set up variables or tokens, build components and variants, modify auto-layout or fills, bind variables to properties, or inspect file structure programmatically.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20d881919dc6d10541b33505\",\"skill_name\":\"figma-use\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-figjam\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-figjam\",\"title\":\"figma-use-figjam\",\"description\":\"This skill helps agents use Figma's use_figma MCP tool in the FigJam context. Can be used alongside figma-use which has foundational context for using the use_figma tool.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20dc8191bd6094a7db25febe\",\"skill_name\":\"figma-use-figjam\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-motion\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-motion\",\"title\":\"figma-use-motion\",\"description\":\"Motion / animation context for the `use_figma` MCP tool — animating Figma nodes via manual keyframes, animation styles, easing, and timeline duration. Load alongside figma-use whenever a task involves adding, editing, or inspecting animation on a node.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20e48191ab14acf69e6241c3\",\"skill_name\":\"figma-use-motion\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-slides\",\"name\":\"plugin_connector_68df038e0ba48191908c8434991bbac2/figma-use-slides\",\"title\":\"figma-use-slides\",\"description\":\"This skill helps agents use Figma's use_figma MCP tool in the Slides context. Can be used alongside figma-use which has foundational context for using the use_figma tool.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_68df038e0ba48191908c8434991bbac2\",\"plugin_name\":\"figma\",\"plugin_release_id\":\"pluginrel_6a90d40e49a88191a5b6c33bdbe308e9\",\"plugin_release_skill_id\":\"pluginrsk_6a90d40f20e88191904cc3f6ec11c9ca\",\"skill_name\":\"figma-use-slides\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"title\":\"plugin-management\",\"description\":\"Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_skill_id\":\"pluginrsk_6a7e9f7d68608191bca9945146cbe6f1\",\"skill_name\":\"plugin-management\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/audit\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/audit\",\"title\":\"Audit\",\"description\":\"Audit or critique a product flow, journey, workflow, funnel, onboarding path, checkout path, settings path, screen, or multi-step product experience by capturing screenshots first, then reporting UX, design, and accessibility findings inline from that evidence. Use Figma only when the user explicitly asks for a board. Use when the user asks to audit, review, critique, inspect, assess, analyze, evaluate, or give feedback on a product experience.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2e4819198bb0d4de951e8b1\",\"skill_name\":\"audit\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/design-qa\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/design-qa\",\"title\":\"Design QA\",\"description\":\"Internal prototype QA helper. Use only after a Product Design prototype, URL-to-code build, or image-to-code build has a source visual target and a rendered implementation to compare before handoff. Do not use for broad UX critique, design critique, product audits, or flow reviews; route those user-facing requests to audit.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2e88191a765961587b3838f\",\"skill_name\":\"design-qa\",\"contents\":[\"references\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/get-context\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/get-context\",\"title\":\"Get Context\",\"description\":\"Mandatory design-brief gate for clarifying the product and outcome. Use before ideation, image-to-code builds, redesigns, or product UI work to clarify missing product information and play back the brief before proceeding.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2e88191a17366f105eed8db\",\"skill_name\":\"get-context\",\"contents\":[],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/ideate\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/ideate\",\"title\":\"Ideate\",\"description\":\"Generate image-based alternatives, remixes, or new design directions from a Product Design brief. Use when the user asks for design variants, visual exploration, remixes, or image-generated approaches from provided context.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2ec8191a50a9d0298778599\",\"skill_name\":\"ideate\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/image-to-code\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/image-to-code\",\"title\":\"Image To Code\",\"description\":\"Implement a selected image, screenshot, mockup, or Image Gen reference as a faithful, responsive frontend.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2ec8191a514a6d71d152450\",\"skill_name\":\"image-to-code\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/index\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/index\",\"title\":\"Product Design\",\"description\":\"Use when Product Design is explicitly invoked, or when the user's main goal is to explore a design, research UX, audit or critique a flow, faithfully clone a visual source, check a built design, or share a prototype. Do not use Product Design for ordinary implementation unless the user explicitly asks for it.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2f08191a926c5cf5a972cf6\",\"skill_name\":\"index\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://Plugin_fa77aec24fc08191bc6e57f377126d76/research\",\"name\":\"Plugin_fa77aec24fc08191bc6e57f377126d76/research\",\"title\":\"Research\",\"description\":\"Run fast, source-grounded UX research on the highest-signal problems users are experiencing with a user-specified digital product. Use when the user asks to research user pain, UX friction, onboarding issues, docs/help problems, developer experience friction, support pain, product workflow issues, or current user complaints for a named product.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"Plugin_fa77aec24fc08191bc6e57f377126d76\",\"plugin_name\":\"product-design\",\"plugin_release_id\":\"pluginrel_6a9577b63d988191a25eb8b07ef41d14\",\"plugin_release_skill_id\":\"pluginrsk_6a9577b6d2f08191adf2ce1684fa42d6\",\"skill_name\":\"research\",\"contents\":[],\"allow_implicit_invocation\":fal
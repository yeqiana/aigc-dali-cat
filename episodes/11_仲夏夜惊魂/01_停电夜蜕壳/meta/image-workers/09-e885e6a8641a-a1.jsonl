ale\\\"},\\\"continuity_policy\\\":{\\\"clothing_and_device_anchors_propagate_to_frame_contract\\\":true,\\\"member_count_changes_require_story_event\\\":true,\\\"pov_character_id_stable\\\":true},\\\"created_at\\\":\\\"2026-08-31T14:20:00+08:00\\\",\\\"derived_from_pools\\\":true,\\\"entry\\\":{\\\"label\\\":\\\"回家/回老家\\\",\\\"reason\\\":\\\"在外地工作的普通年轻人请了两天假，夜里返乡参加第二天发小的婚礼；停电后从县城客运站步行回家\\\",\\\"source\\\":\\\"story_os_selection\\\",\\\"type\\\":\\\"return_home\\\"},\\\"era\\\":{\\\"bucket\\\":\\\"modern_2020s\\\",\\\"source\\\":\\\"story_os_selection\\\",\\\"year\\\":2026},\\\"forbidden_role_check\\\":{\\\"hits\\\":[],\\\"pass\\\":true},\\\"locked_at\\\":\\\"2026-08-31T14:20:00+08:00\\\",\\\"no_anomaly_test\\\":{\\\"must_be_rechecked_before_story_lock\\\":true,\\\"ordinary_day_plan\\\":\\\"夜班客车到县城后步行或打车回家，洗澡睡觉，第二天参加发小婚礼；高温和临时停电只会让返家更麻烦。\\\",\\\"pass\\\":true,\\\"question\\\":\\\"如果删掉所有异常，这一天是否仍像真实生活？\\\",\\\"rechecked_against_final_story\\\":true},\\\"not_episode_stage\\\":true,\\\"ordinary_person_score\\\":100,\\\"pov\\\":{\\\"character_id\\\":\\\"P01\\\",\\\"first_person\\\":true},\\\"role_policy\\\":{\\\"career_function\\\":\\\"none\\\",\\\"protagonist_role\\\":\\\"普通年轻人\\\",\\\"solves_anomaly_professionally\\\":false},\\\"scene\\\":{\\\"primary_category\\\":\\\"county_town\\\",\\\"primary_place\\\":\\\"中国西北虚构县城“槐川县”的客运站—老商业街—步行天桥—普通住宅小区\\\"},\\\"schema_version\\\":1,\\\"selection_seed\\\":202608311101,\\\"status\\\":\\\"LOCKED\\\",\\\"story_build_note\\\":\\\"Story Lock 已复核：主角没有专业异常处理职能；返乡动机在删除全部异常后仍成立。\\\"}\n\n[WORLD IDENTITY NOT APPLICABLE]\n\n[CHARACTER APPEARANCE ANCHOR NOT APPLICABLE]\n\n[CONTINUITY]\n{\\\"anchors\\\":{\\\"anomaly_material\\\":\\\"县城本身是垂死巨物：表皮极薄半透明且边缘甲片分层，携带颜色/反光/标线等表面信息；表皮下是暗灰粗糙带浅骨板纹理的躯体表面，门窗接口错位；山脊=卧兽背脊，路灯杆=须，楼群=鳞甲\\\",\\\"location\\\":\\\"槐川县空间链：客运站→老商业街→十字路口→河渠步道→步行天桥→普通住宅小区\\\",\\\"protagonist\\\":\\\"P01 周启明，24岁男性第一人称；黑短发；黑短袖+深灰工装裤+普通运动鞋；只自然露手臂/裤腿/鞋等局部\\\",\\\"weather_time\\\":\\\"仲夏极热夜，22:42抵达，23:03停电，23:51高潮，00:06复电，次日上午残留\\\"},\\\"required\\\":[\\\"protagonist\\\",\\\"location\\\",\\\"weather_time\\\",\\\"anomaly_material\\\"]}\n\n[ENVIRONMENT PHYSICS]\n{\\\"condition\\\":\\\"全县停电后的低照极热街区\\\",\\\"conditional_effects\\\":[{\\\"effect\\\":\\\"手机手电照近处时背景迅速掉黑\\\",\\\"when\\\":[\\\"frame 5-9\\\",\\\"近距离观察\\\"]}],\\\"ground_state\\\":\\\"干燥沥青与水泥路面，白天积热未散\\\",\\\"physical_cues\\\":[\\\"大面积人工照明消失\\\",\\\"汽车灯和手机手电形成局部硬光\\\",\\\"高ISO噪点/轻运动模糊只在物理需要时出现\\\"],\\\"precipitation\\\":\\\"无\\\",\\\"temperature_feel\\\":\\\"白天约40℃后的积热仍明显，夜间体感约31℃，空气干热闷滞\\\",\\\"time_of_day\\\":\\\"22:42-00:10 夜间\\\",\\\"visibility\\\":\\\"停电前普通县城夜景；停电后依靠车灯、手机和极少应急光\\\",\\\"wind\\\":\\\"前段弱风，后段出现间歇性热风\\\"}\n\n[CAPTURE EVENT]\n{}\n\n[PERSISTENT WORLD STATE]\n{}\n\n[CHARACTER VISUAL / ORIGINAL IDENTITY]\n{\\\"created_at\\\":\\\"2026-08-31T19:40:19+08:00\\\",\\\"lock_model\\\":\\\"identity_spec__provisional_baseline_master__final_visual_lock_master\\\",\\\"master_policy\\\":{\\\"crop_manifest_artifact\\\":\\\"meta/character-master-crops.json\\\",\\\"derived_crops_are_not_new_identity_generation\\\":true,\\\"final_master_after_four_admission_pass\\\":true,\\\"ordinary_baseline_can_become_group_identity_master\\\":true,\\\"pixel_master_artifact\\\":\\\"meta/character-pixel-master.json\\\",\\\"preferred_identity_source\\\":[\\\"character_individual_crop\\\",\\\"character_pixel_master\\\",\\\"ordinary_baseline_group_selfie\\\",\\\"original_character_library_asset\\\"],\\\"preproduction_only_must_not_generate_master_images\\\":true,\\\"provisional_master_after_baseline_review_pass\\\":true},\\\"members\\\":{\\\"P01\\\":{\\\"attractiveness\\\":\\\"moderately_above_average_but_real\\\",\\\"body_build\\\":\\\"lean_proportionate_natural\\\",\\\"body_build_story_override_reason\\\":\\\"\\\",\\\"face_identity\\\":{\\\"celebrity_likeness\\\":false,\\\"fashion_model_styling\\\":false,\\\"identity_spec_locked\\\":false,\\\"independently_distinct_face\\\":true,\\\"influencer_face\\\":false,\\\"original_character\\\":true,\\\"reference_similarity
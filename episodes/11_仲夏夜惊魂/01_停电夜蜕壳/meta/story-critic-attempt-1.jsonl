ed_return_guidance_marking_behaviors\": true\n      }\n    },\n    {\n      \"id\": \"R008\",\n      \"dimension\": \"causal_order\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"rule_warning_occurs_after_violation\": true,\n        \"prior_rule_setup_exists\": false\n      }\n    },\n    {\n      \"id\": \"R009\",\n      \"dimension\": \"character_stake\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"missing_person_becomes_plot_tool\": true,\n        \"relationship_stake_not_established\": true\n      }\n    },\n    {\n      \"id\": \"R010\",\n      \"dimension\": \"climax_payoff\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"climax_is_discovery_only\": true,\n        \"choice_or_cost\": false\n      }\n    },\n    {\n      \"id\": \"R011\",\n      \"dimension\": \"ending_payoff\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"ending_adds_new_mechanism\": true,\n        \"recontextualized_prior_facts\": 0\n      }\n    },\n    {\n      \"id\": \"R012\",\n      \"dimension\": \"subtitle_layout\",\n      \"expected\": \"auto_fix\",\n      \"source\": \"用户锁定规则\",\n      \"fixture\": {\n        \"wrapped_second_line\": \"。！？……”）\",\n        \"contains_semantic_character\": false,\n        \"required_action\": \"drop_entire_second_line\"\n      }\n    }\n  ]\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"\"C:\\\\Users\\\\79873\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw -Encoding UTF8 'standards/创作执行强制规范_V2.0.3.2.md'\"","aggregated_output":"# Story OS V2.0.3.2｜创作执行强制规范\n\n> 身份：`standards/制作规范_正式版.md` 的 active subordinate execution contract。\n> 不建立第二状态机；只把既有 Story Lock / Visual Lock / Release 的创作要求变成可失败的证据门禁。\n\n## 1. Story Lock：先可理解，再生产\n\nV2.0.3.2 新篇在 Story Lock 前必须存在 `meta/story-semantic-review.json`，且由独立 Codex session 审查。\n\n硬要求：\n\n1. 主角、到场原因、个人代价必须明确。\n2. 一篇只能有一套可统一解释主要现象的核心异常机制。\n3. 因果链必须成立：现实目标 → 规则/铺垫 → 有意义的选择/违反 → 直接后果 → 被迫继续行动 → 高潮选择/代价 → 结果 → 余波。\n4. “找到人 / 门打开 / 怪物出现 / 照片变化”只能是高潮前置，不得单独作为高潮。\n5. 高潮至少兑现：选择、代价、关系变化、规则兑现、身份翻转、不可逆后果之一。\n6. 终局必须重新解释至少 3 个前文具体事实；禁止靠结尾突然增加一套新机制伪装反转。\n7. 任意连续 5 张至少有一次新证据、因果转折或认知升级。\n8. 执行删图测试：删掉后不影响因果、理解、悬念、可信度或必要空间过渡的帧，应合并或删除。\n9. 独立 Critic 必须完成五句盲复述；核心机制或高潮需要靠“可能/大概/不清楚”才能解释时，不得 PASS。\n10. 传播评分不能替代语义门禁。\n\nFull-auto 允许自动修故事一次；第二次独立 Critic 仍 FAIL 时停止，不得 delegated Story Lock。\n\n## 2. Visual Lock：默认 M00 必须真的进入生成请求\n\n用户未明确指定其他风格时，继续解析：\n\n`M00｜MP4 × 网吧 × 流水席旧数码质感校准版`\n\n但 V2.0.3.2 不再只锁 Profile 文件：\n\n`resolve profile → compact visual contract → 每次正式 image request 注入 → 三张真实性校准实际视觉审查 → Visual Lock`\n\n三张校准必须由独立视觉 Critic 对实际图片逐项确认：\n\n- visual_profile_match\n- reality_first\n- ordinary_life_density\n- available_light\n- unposed_capture\n- not_cinematic\n- causal_imperfection\n\n不能因为提示词写了 M00 就判图片通过。\n\n`capture_style` 参考只能来自：\n- 已通过的三张 calibration；\n- 明确登记并通过的 capture-style reference。\n\n普通刚生成、尚未批准的帧禁止反过来当 `capture_style`，避免错误风格自我放大。\n\n## 3. 字幕最终排版硬规则\n\n字幕仍遵守最终视觉规范。\n\n新增不可违反规则：\n\n> 字幕换行后，如果第二行不存在中文、英文或数字，只有标点符号，则整行直接舍弃。\n\n例如：\n\n```text\n昨天我明明已经把它锁进柜子里了\n。\n```\n\n最终必须渲染为：\n\n```text\n昨天我明明已经把它锁进柜子里了\n```\n\n不把标点搬回第一行，不保留孤立标点行。\n\nV2.0.3.2 新篇正式字幕必须通过 `episodes/_system/subtitle_layout.py render-all` 生成 publish 图，并产生 `meta/subtitle-layout-audit.json`。PUBLISH_READY 会验证该审计及输出 SHA。\n\n## 4. 状态机不变\n\n仍只有：\n\n`IDEA_LOCKED → STORYBOARD_LOCKED → VISUAL_CALIBRATED → PRODUCTION_PASSED → PUBLISH_READY → PUBLISHED → DATA_REVIEWED`\n\n本规范新增的 review/audit 文件全部是 evidence，不是第二状态源。\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"\"C:\\\\Users\\\\79873\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw -Encoding UTF8 'episodes/11_仲夏夜惊魂/01_停电夜蜕壳/story/02_Storyboard.md'\"","aggregated_output":"# 《仲夏夜惊魂｜停电夜蜕壳》20 张正式分镜 V2.1\n\n> 画幅：4:5（1080×1350）  \n> 主设备：2026 年普通智能手机，第一人称手持  \n> 视觉母风格：M00，但现代手机物理表现优先，不做假旧数码噪点  \n> Visual Lock 1+3 计划：01 baseline → 05 worst / 08 first anomaly / 17 high-impact  \n> 禁止生成阶段：本文件仅用于 preproduction_only；当前无任何图片资产。\n\n## 图 01｜返乡基线\n- **场景**：客运站外普通夏夜\n- **Story Beat**：ordinary baseline\n- **画面合同**：刚下夜班客车，手机随手拍站前广场：普通县城客运站、便利店、停着的出租车、婚庆店门口未拆的红色充气拱门，空气仍有热浪感。画面必须完全无异常。\n- **字幕草案**：我到县城的时候，已经快十一点了。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 02｜生活锚点\n- **场景**：拖包离站\n- **Story Beat**：setup\n- **画面合同**：第一人称低机位，右下角偶尔带到黑色旅行包拉杆和主角手臂；站前夜宵摊、塑料桌椅、行人穿夏装，手机正常夜景但不要商业HDR。\n- **字幕草案**：白天四十度，晚上还是闷得喘不过气。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 03｜停电前一秒\n- **场景**：老商业街入口\n- **Story Beat**：transition\n- **画面合同**：远处商铺、红绿灯、居民楼窗户仍亮，街面普通；构图略歪像边走边拍。手机夜景取景框里，远处药房外墙角有一条米黄色饰面轻微卷边，像白天被晒坏的墙皮，具体可辨但一闪而过；热空气轻微扭曲远处灯牌。\n- **字幕草案**：我家离车站不远，我准备走回去。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读；该卷边与图06/07/19为同一面墙（药房外墙），由手机记录载体承担前3张的首处可辨认异常证据。\n\n## 图 04｜全县停电\n- **场景**：光源同时消失\n- **Story Beat**：worst condition setup\n- **画面合同**：同一路口突然黑下去，只剩车辆前灯、刹车灯、手机屏幕和一家店内极弱应急灯；不能拍成末日电影，仍是普通街区突发停电。\n- **字幕草案**：23点03分，整条街一下全黑了。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 05｜最差但成立条件\n- **场景**：摸黑步行\n- **Story Beat**：worst condition\n- **画面合同**：手机手电偶尔扫到路沿、广告牌背面、关门商铺；高温、汗、低照度、轻运动模糊真实成立，但主体可读。没有超自然异常。\n- **字幕草案**：打车软件一直转圈，我就继续往家走。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 06｜第一处材料异常前兆\n- **场景**：药房招牌后卷边\n- **Story Beat**：evidence\n- **画面合同**：手机灯照到药房招牌后，一条米黄色外墙饰面向下卷，乍看像高温鼓包脱落；卷边薄、真实材质，背景仍正常。\n- **字幕草案**：我先以为是墙皮被晒坏了。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 07｜异常露底\n- **场景**：错位蓝灰墙\n- **Story Beat**：first anomaly lead\n- **画面合同**：靠近但保持安全距离拍：米黄色表层像薄膜垂下，后方蓝灰粗糙墙面上的旧孔位和现有窗洞错开约半米；尺度用窗框、空调支架孔作参照。\n- **字幕草案**：可它后面那扇窗的位置，不对。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 08｜首次重大异常\n- **场景**：不同材质同向翘起\n- **Story Beat**：first major anomaly\n- **画面合同**：一张画面同时看到药房墙膜、隔壁橱窗最外反光层、路沿黄色漆都向县城中心方向卷起，彼此隔开却动作一致；无字即可看出“不是普通墙皮”。\n- **字幕草案**：我站远了一点，才发现不只这一面墙。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 09｜路面第二层\n- **场景**：井盖与车道线错位\n- **Story Beat**：reveal\n- **画面合同**：十字路口，沥青最上层从井盖边缘卷起像极薄黑色皮，下面露出另一套更窄旧车道线和偏位井盖；一辆普通轿车经过提供比例。\n- **字幕草案**：连路面都有一层。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 10｜连通证明\n- **场景**：街角表层连成膜\n- **Story Beat**：mid escalation\n- **画面合同**：广角但仍手机手持：墙面颜色、广告画面、玻璃倒影、路面标线在街角被一张连续半透明薄层连接起来，薄层离地约一米；楼体和车辆清楚作尺度参照。\n- **字幕草案**：它们像是同一张东西。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 11｜主角的选择\n- **场景**：河渠步行道入口\n- **Story Beat**：meaningful choice\n- **画面合同**：第一人称站在河渠步行道入口：前方护栏上方悬垂着低低的半透明膜层，几乎贴到路面；身后是回客运站的普通街口，远处近路方向能看见卷起的表层正封住街口。手机时间可见 23:26。构图是“往前走”的视角，主体是那条危险但能回家的路。\n- **字幕草案**：我得在天亮前赶回家——明天我是伴郎。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 12｜触碰的后果：碎片粘包与退路被封\n- **场景**：河渠步行道中段\n- **Story Beat**：direct consequence\n- **画面合同**：第一人称低机位，侧身挤过低垂到腰部的悬垂膜层：旅行包一侧蹭到膜缘，一块巴掌大的浅黄色饰面当场撕下、粘在包上扯不掉（这块正是药房外墙的表层被卷进皮里的部分）；手机手电扫到悬垂膜面时，光照处卷边肉眼可见地加速，他拇指按下关灯、屏幕熄灭；身后刚挤过的入口处，表层像皮一样从两侧合拢，把退路封死。构图必须让“碎片粘包、退路被封、灯光加速卷边”三者无字可读。\n- **字幕草案**：它挨到包就撕下一块，粘住扯不掉；回头路也被它合上了。灯一照，卷得更快，我关了手电。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读；碎片与图18/19为同一块、同材质同尺寸。\n\n## 图 13｜天桥下方\n- **场景**：表层离地两三米\n- **Story Beat**：anomaly amplified\n- **画面合同**：步行天桥下看一整段街：带招牌颜色和窗户反射的薄层悬在离地2–3米处，下面灰暗楼面门洞偏位；隔着河渠能看见对岸几栋楼的楼角也同向卷起，像整张城市包装膜从外围向中心收缩；街灯、栏杆、人行道宽度提供尺度。\n- **字幕草案**：我到天桥下面时，终于看清它有多大。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 14｜里层县城\n- **场景**：错位入口被暴露\n- **Story Beat**：reveal\n- **画面合同**：手机从天桥楼梯中段斜拍：下方建筑实体门窗比表层“画面”错位，原本门口位置后面是实墙，而旁边一米多才有黑洞一样的新门洞；不要出现怪物。\n- **字幕草案**：外面那层，和里面根本对不上。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 15｜整街抬升\n- **场景**：城市皮越过二楼\n- **Story Beat**：high impact lead\n- **画面合同**：强热风下，一整条街的表面薄层向上鼓起，已经高过二楼；薄层上仍保留广告颜色、玻璃高光、斑马线碎片般的视觉信息。公交站棚、六层楼作尺度。\n- **字幕草案**：那阵风一来，整条街都被掀了起来。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 16｜县城中心开始蜕壳\n- **场景**：多街区连片\n- **Story Beat**：high impact admission\n- **画面合同**：天桥接近最高处，视野里三个街区的表层互相连成巨大的半透明壳，边缘从楼顶掠过；下方裸露建筑全部暗、粗糙、开口错位。保持手机夜拍物理限制。\n- **字幕草案**：我这才明白，它不是在掉墙皮。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\n## 图 17｜高潮：穿越与整城蜕壳\n- **场景**：天桥最高处\n- **Story Beat**：climax choice + cost\n- **画面合同**：第一人称抓拍正在发生的一瞬：主角小跑在天桥桥面，右手举着手机拍摄、手机是松握的，膜层边缘正从身侧扫过，松握的手机被膜缘整只卷走、腾空离手；他左手紧攥旅行包带——紧握或连体的东西膜缘只划过、不夺走，前臂被边缘留下一道细红痕；县城中心整片半透明“城市表皮”被热风托到楼顶上方30–50米，像巨大空心蝉蜕，膜上能辨出道路标线、窗面反光和招牌色块，下方是黑暗错位县城。六层住宅、公交车、路灯、天桥栏杆必须明确给出尺度。\n- **字幕草案**：我跑过去的时候，它把整座城蜕了下来。松握的手机被卷走，攥紧包带的手只被划了一道。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读；高潮必须是“选择与代价”的像素事件，不只是发现；“松握被卷走、紧握只被划过”的规则兑现必须同帧可辨。\n\n## 图 18｜代价与闭环\n- **场景**：小区门口/家中\n- **Story Beat**：cost + task payoff\n- **画面合同**：00:06 电力恢复，窗外居民楼逐层亮灯，县城表面看似正常；第一人称低头看自己的前臂，有一道被膜缘划过的细红痕；旅行包靠在门边，包上粘着一块巴掌大的浅黄色饰面碎片——正是图12从膜缘撕下、一路带回家的那一块，和墙面饰面同材质、同纹理。桌上的手机充电线空着——手机不在。\n- **字幕草案**：零点过几分，电来了。我到了家，手机却没了。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读；碎片必须与墙面饰面同材质、同尺寸可辨，且与图12为同一块。\n\n## 图 19｜次日：药房缺失的一块\n- **场景**：药房外墙\n- **Story Beat**：residue payoff\n- **画面合同**：第二天上午自然日光，药房外墙缺了一块巴掌大的浅黄色饰面，露出下方蓝灰粗糙墙面，窗框旧孔位与现实窗户错开约半米；缺口边缘的卷边残余与昨夜膜缘纹理相同，缺口轮廓与包上/抽屉里碎片形状一致——它就是被卷进那张皮里、又在主角身上被撕下来的那一块。背景街道普通、县城看似正常。构图让“缺的那一块”和错位窗洞在无字下可读。\n- **字幕草案**：药房外墙缺了一块——和我抽屉里那块一模一样。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读；缺失尺寸与碎片一致（巴掌大），缺口轮廓与碎片同形。\n\n## 图 20｜次日残留 / 终局重读\n- **场景**：阳台远景透明弧膜\n- **Story Beat**：residue\n- **画面合同**：第二天上午自然日光，从普通住宅阳台拍整个县城和远山，城市完全正常；县城边缘到山口上空有一条极薄、巨大、近透明弧形膜捕捉阳光反射，像昨夜那张壳在边缘没有完全落回、仍有一截松着。必须靠城市与山体尺度成立，不能像科幻海报。\n- **字幕草案**：第二天我才发现，昨晚掉下来的可能不是墙皮。\n- **硬约束**：真实手机相册感；第一人称；不摆拍；不增加专业角色；异常必须在像素中可读。\n\r\n","exit_code":0,"status":"completed"}}

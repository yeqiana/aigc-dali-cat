    "visual_review_legacy.py",
    "codex_auto_orchestrator.py"
  ],
  "test_patterns": [
    "test_*.py"
  ],
  "agent_read_policy": "Start from canonical_entrypoints and the category required by next-action.json. Do not broad-read legacy/test modules unless a gate, migration, or regression requires them. step_engines are steps, not drivers: runtime_dag.py executes named nodes and returns -- it never starts the host loop, writes no heartbeat and leaves no HOST_LOOP evidence. The only resident driver is story_os.py runner. Long steps outlive the host call's budget via `story_os.py driver start`, which launches that same resident driver detached (`runtime_driver.py`) -- it is not a second driver. A restarted driver claims its predecessor's in-flight Codex result (`inflight_codex_task.py`) instead of paying for the same step twice."
}

    "visual_lock_v21.py",
    "frame_semantic_review.py",
    "incremental_frame_review.py",
    "release_preflight.py"
  ],
  "diagnostic_tools": [
    "caption_ocr_diagnostic.py",
    "visual_face_diagnostic.py",
    "identity_sface_diagnostic.py",
    "image_technical_gate.py",
    "repair_integrity.py",
    "visual_fingerprint.py",
    "visual_embedding_provider.py",
    "sface_shadow_runtime.py",
    "local_visual_triage_summary.py",
    "subtitle_face_safe_area.py"
  ],
  "release": [
    "final_candidate_snapshot.py",
    "delegated_delivery.py",
    "release_package.py"
  ],
  "data_health": [
    "text_encoding_health.py",
    "runtime_portability.py",

     \"authority\": \"active_subordinate\",\n      \"scope\": \"codex_auto_orchestration_and_subscription_image\",\n      \"active\": true\n    },\n    {\n      \"path\": \"standards/生产闭环与委托批准规范_V2.0.2.md\",\n      \"authority\": \"active_subordinate\",\n      \"scope\": \"production_closure_delegated_approval\",\n      \"active\": true\n    },\n    {\n      \"path\": \"standards/最终字幕视觉规范_V1.2.md\",\n      \"authority\": \"active_subordinate\",\n      \"scope\": \"caption_visual\",\n      \"active\": true,\n      \"supersedes\": [\n        \"standards/最终字幕视觉规范_V1.1.md\"\n      ]\n    },\n    {\n      \"path\": \"standards/创作执行强制规范_V2.0.3.2.md\",\n      \"authority\": \"active_subordinate\",\n      \"scope\": \"creative_enforcement\",\n      \"active\": true\n    },\n    {\n      \"path\": \"standards/生产帧语义强制规范_V1.0.md\",\n      \"authority\": \"active_subordinate\",\n      \"scope\": \"production_frame_semantic_fidelity\",\n      \"active\": true\n    },\n    {\n      \"path\": \"standards/工作区与增量闭环规范_V1.0.md\",\n      \"authority\": \"active_subordinate\",\n      \"scope\": \"incremental_execution_and_local_media_workspace\",\n      \"active\": true,\n      \"note\": \"Defines minimal closure, dirty propagation, local media workspace, SHA index and safe migration. Does not create a second stage source.\"\n    }\n  ],\n  \"rules\": {\n    \"superseded_default_read\": false,\n    \"unknown_versioned_standard_is_warning\": true,\n    \"series_overlay_may_override_canonical\": false,\n    \"state_source\": \"meta/episode-state.json\",\n    \"default_visual_profile\": {\n      \"id\": \"M00\",\n      \"name\": \"MP4 × 网吧 × 流水席旧数码质感校准版\",\n      \"profile_path\": \"standards/visual_profiles/M00_MP4_网吧_流水席_旧数码.json\",\n      \"standard_path\": \"standards/风格锚点_MP4_网吧_流水席_旧数码_V1.2.md\",\n      \"use_when_unspecified\": true,\n      \"explicit_override_wins\": true,\n      \"capture_physics_and_story_era_win_over_texture\": true\n    },\n    \"runtime_routing\": {\n      \"c
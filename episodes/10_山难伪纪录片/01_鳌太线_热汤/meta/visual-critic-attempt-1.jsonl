ecified\": true,\n      \"explicit_override_wins\": true,\n      \"capture_physics_and_story_era_win_over_texture\": true\n    },\n    \"runtime_routing\": {\n      \"contract\": \"runtimes/runtime-contract.json\",\n      \"order\": [\n        \"CODEX\",\n        \"WORK\",\n        \"WEB\"\n      ],\n      \"ask_user_to_choose\": false,\n      \"second_stage_forbidden\": true,\n      \"stable_evidence_gate\": \"episodes/_system/evidence_gate.py\"\n    },\n    \"capture_profile_registry\": {\n      \"path\": \"standards/capture_profiles/index.json\",\n      \"default_profile_id\": \"CP01\",\n      \"capture_physics_over_texture\": true\n    },\n    \"story_regression_library\": {\n      \"path\": \"standards/story_regressions/cases.json\"\n    },\n    \"episode_fingerprint\": {\n      \"episode_path\": \"meta/episode-fingerprint.json\",\n      \"account_registry\": \"reports/account-pattern-registry.json\",\n      \"recent_compare_count\": 5,\n      \"mechanism_veto\": true\n    },\n    \"codex_auto_orchestrator\": {\n      \"path\": \"episodes/_system/codex_auto_orchestrator.py\",\n      \"image_backend\": \"episodes/_system/codex_subscription_image.py\",\n      \"approval_basis\": \"delegated_auto_review\",\n      \"may_fake_user_approval\": false\n    },\n    \"delegated_approval\": {\n      \"path\": \"episodes/_system/delegated_approval.py\",\n      \"requires_continuous_execution_authorized\": true,\n      \"may_fake_user_approval\": false\n    },\n    \"production_closure\": {\n      \"orchestrator\": \"episodes/_system/codex_auto_orchestrator.py\",\n      \"canvas_normalizer\": \"episodes/_system/canvas_normalize.py\",\n      \"delivery\": \"episodes/_system/delegated_delivery.py\",\n      \"completion_states\": [\n        \"COMPLETE\",\n        \"PAUSED\",\n        \"BLOCKED\"\n      ],\n      \"frame_semantic_review\": \"episodes/_system/frame_semantic_review.py\"\n    },\n    \"creative_enforcement\": {\n      \"story_review\": \"episodes/_system/story_rev
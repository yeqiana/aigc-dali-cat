       \"same_anomaly_has_unexplained_return_guidance_marking_behaviors\": true\n      }\n    },\n    {\n      \"id\": \"R008\",\n      \"dimension\": \"causal_order\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"rule_warning_occurs_after_violation\": true,\n        \"prior_rule_setup_exists\": false\n      }\n    },\n    {\n      \"id\": \"R009\",\n      \"dimension\": \"character_stake\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"missing_person_becomes_plot_tool\": true,\n        \"relationship_stake_not_established\": true\n      }\n    },\n    {\n      \"id\": \"R010\",\n      \"dimension\": \"climax_payoff\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"climax_is_discovery_only\": true,\n        \"choice_or_cost\": false\n      }\n    },\n    {\n      \"id\": \"R011\",\n      \"dimension\": \"ending_payoff\",\n      \"expected\": \"fail\",\n      \"source\": \"鳌太线管护站失败复盘\",\n      \"fixture\": {\n        \"ending_adds_new_mechanism\": true,\n        \"recontextualized_prior_facts\": 0\n      }\n    },\n    {\n      \"id\": \"R012\",\n      \"dimension\": \"subtitle_layout\",\n      \"expected\": \"auto_fix\",\n      \"source\": \"用户锁定规则\",\n      \"fixture\": {\n        \"wrapped_second_line\": \"。！？……”）\",\n        \"contains_semantic_character\": false,\n        \"required_action\": \"drop_entire_second_line\"\n      }\n    }\n  ]\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"\"C:\\\\Users\\\\79873\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw -LiteralPath 'standards/传播核与动作回应链规范_V1.0.md'\"","aggregated_output":"# 传播核与动作回应链规范 V1.0\n\n> Story OS V2.5 active subordinate standard。唯一创作权威仍是 `standards/制作规范_正式版.md`。\n>\n> 本规范把账号真实发布数据支持的“人物进场 + 事件扩池”经验变成 Story Lock 前后的机器门禁。\n> 它约束的是传播结构，不要求复制任何已发布作品的表面题材。\n\n## 一、核心原则\n\n**人物负责进场，事件负责扩池。**\n\n推荐默认公式：\n\n> 真实人物让用户相信这事发生过；普通动作让用户代入；异常回应让用户产生转述/分享冲动。\n\n除了“异常够不够大”，每个传播型故事还必须回答：\n\n> **有没有一个能在 10 秒内讲给朋友听的动作 → 后果？**\n\n## 二、Propagation Core\n\nV2.5+ 新 Episode 的独立 Story Critic 必须在 `meta/story-semantic-review.json` 中输出：\n\n```json\n{\n  \"propagation_core\": {\n    \"retell_sentence\": \"10 秒内可转述的一句话\",\n    \"protagonist_action\": \"人物主动做了什么\",\n    \"abnormal_response\": \"异常如何直接回应\",\n    \"consequence\": \"回应造成了什么可见后果\",\n    \"response_latency\": \"immediate\",\n    \"visual_causality\": \"strong\",\n    \"retellable_in_10s\": true,\n    \"social_send_impulse\": \"strong\",\n    \"trigger_frame\": 9,\n    \"response_frame\": 10,\n    \"payoff_frame\": 14,\n    \"late_trigger_exception_reason\": \"\",\n    \"surface_copy_guard\": {\n      \"structural_reference_only\": true,\n      \"copied_surface_elements\": []\n    }\n  }\n}\n```\n\n允许值：\n\n- `response_latency`: `immediate | short | delayed_but_direct`\n- `visual_causality`: `strong | medium | weak`\n- `social_send_impulse`: `strong | medium | weak`\n\n## 三、SHAREABILITY LOCK\n\n进入 `STORYBOARD_LOCKED` 前必须同时满足：\n\n1. **主动动作成立**：人物主动做一个普通人自然会做的动作，而不是只“看见更多异常”。\n2. **异常直接回应**：异常世界对这个动作产生可辨认反馈。\n3. **因果可画**：连续画面能说明“动作发生 → 对面回应 → 后果出现”。\n4. **10 秒可转述**：无需先解释长世界观、三条规则或多个专有名词。\n5. **触发位置健康**：默认 `trigger_frame / total_frames <= 0.5`；若更晚，必须给具体理由。\n6. **不复制表皮**：Golden Episode 只继承结构，不允许把地点、道具、动作、高潮画面整体换皮复刻。\n\n## 四、硬失败码\n\n- `PROPAGATION_CORE_MISSING`\n- `ACTION_RESPONSE_CHAIN_WEAK`\n- `RETELLABILITY_FAILED`\n- `VISUAL_CAUSALITY_WEAK`\n- `ACTION_RESPONSE_ORDER_BROKEN`\n- `TRIGGER_TOO_LATE_WITHOUT_REASON`\n- `SURFACE_COPY_GUARD_FAILED`\n\n任一硬失败均不得通过 Storyboard Lock。\n\n## 五、Storyboard 图号约束\n\n传播核必须明确：\n\n- `trigger_frame`\n- `response_frame`\n- `payoff_frame`\n\n且满足：\n\n`1 <= trigger_frame <= response_frame <= payoff_frame <= total_frames`\n\n标准 20 图作品建议 Trigger 约在 08–10 图。不是死规定；合理慢热可更晚，但必须填写\n`late_trigger_exception_reason`。\n\n## 六、Visual Narrative 责任\n\n生产前后保持：\n\n`setup → trigger → response → payoff`\n\n其中 Trigger 图看得出人物动作；Response 图看得出环境/异常在回应；Payoff 图必须兑现新后果或现实残留。\n\n## 七、Golden Episode：学结构，不学皮肤\n\n`10_彼此的天上/01_不存在的夜行路` 可作为传播型结构参考，允许学习：\n\n- ordinary_relationship_entry\n- credible_daily_context\n- low_cognitive_load\n- active_human_trigger\n- immediate_abnormal_response\n- visually_readable_causality\n- ten_second_retellability\n- open_explanation\n- normal_person_exit\n- reality_recheck\n\n禁止默认复刻：\n\n- 川西 / 山路\n- 远处灯队\n- 远光灯互动\n- 同款情侣自驾开局\n- 同样的“灯依次熄灭”高潮\n\n## 八、发布后验证\n\n传播核最终由真实数据验证，不由预测分冒充。\n\n发布后漏斗固定解释为：\n\n`L1 进场 → L2 留存 → L3A 认可 → L3B 传播 → L4 作者链`\n\n- L3A：点赞 / 评论 / 收藏\n- L3B：分享\n- L4：主页访问 / 关注 / 净增粉\n\n报告默认采用：\n\n**绝对数量 → 阶段增量 → 效率/比例**\n\n不得只用百分比描述作品表现。\n\r\n","exit_code":0,"status":"completed"}}

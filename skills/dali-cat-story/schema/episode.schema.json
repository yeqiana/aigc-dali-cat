{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/dali-cat-story/episode.schema.json",
  "title": "Dali Cat Story Episode Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "episode",
    "format",
    "paths",
    "story",
    "anti_homogeneity",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "enum": [
        "candidate",
        "story_locked",
        "visual_admission",
        "production",
        "subtitled",
        "release_ready",
        "published"
      ]
    },
    "episode": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "publish_mode",
        "ratio",
        "width",
        "height",
        "frame_count"
      ],
      "properties": {
        "publish_mode": {
          "const": "image_carousel"
        },
        "ratio": {
          "const": "9:16"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "story": {
      "type": "object"
    },
    "anti_homogeneity": {
      "type": "object"
    },
    "continuity": {
      "type": "object"
    },
    "subtitles": {
      "type": "object"
    },
    "locks": {
      "type": "object"
    },
    "review": {
      "type": "object"
    }
  }
}

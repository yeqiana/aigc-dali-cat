        "resident_context": "Japanese local residents",
        "default_protagonist_age_range": [
          19,
          30
        ],
        "default_protagonist_identity": "ordinary Japanese young adult",
        "ethnicity_policy": "story_defined",
        "foreign_character_policy": "story_defined"
      }

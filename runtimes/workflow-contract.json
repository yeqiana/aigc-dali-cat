{
  "schema_version": 1,
  "workflow_version": "2.1",
  "name": "Story OS V2.1 Workflow Engine Foundation",
  "episode_stage_source": "meta/episode-state.json",
  "checkpoint_source": "meta/runtime-checkpoint.json",
  "rules": {
    "do_not_create_second_episode_stage": true,
    "cheap_checks_before_expensive_checks": true,
    "reuse_clean_sha_bound_evidence": true,
    "zip_is_delivery_adapter_not_stage_gate": true,
    "codex_production_complete_at_publish_ready": true,
    "concept_ambition_before_story_lock": true,
    "image_first_propagation_gate": true,
    "reality_limits_capture_not_concept": true,
    "environment_is_physics_not_filter": true,
    "anomaly_amplified_requires_scale_reference": true,
    "environment_changes_use_per_frame_hashes": true,
    "resolved_frame_contract_is_derived_cache": true,
    "generation_and_review_bind_same_frame_contract_sha": true,
    "storyboard_local_hash_when_extractable": true,
    "visual_lock_four_admissions": true,
    "high_impact_must_deliver_without_becoming_cinematic": true,
    "max_parallel_image_workers": 3,
    "production_ledger_single_writer": true,
    "technical_failure_does_not_consume_content_repair": true,
    "scheduler_fail_soft": true,
    "adaptive_parallel_3_to_2_to_1": true,
    "fast_scout_never_final_pass": true,
    "low_risk_scout_defers_without_model_call": true,
    "scout_technical_failure_defers_to_final": true,
    "final_candidate_snapshot_before_publish_ready": true,
    "delivery_consumes_verified_snapshot": true,
    "snapshot_is_evidence_not_authority": true
  },
  "steps": {
    "RESTORE": {
      "depends_on": [],
      "cost": "CHEAP",
      "parallelizable": false
    },
    "INCREMENTAL_PLAN": {
      "depends_on": [
        "RESTORE"
      ],
      "cost": "CHEAP",
      "parallelizable": false
    },
    "TOPIC_GUARD": {
      "depends_on": [
        "INCREMENTAL_PLAN"
      ],
      "cost": "MEDIUM",
      "parallelizable": false
    },
    "CONCEPT_DIVERGENCE": {
      "depends_on": [
        "TOPIC_GUARD"
      ],
      "cost": "MEDIUM",
      "parallelizable": false,
      "contract": "8-12 candidates"
    },
    "CONCEPT_AMBITION": {
      "depends_on": [
        "CONCEPT_DIVERGENCE"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": false,
      "evidence": "meta/concept-ambition-review.json"
    },
    "IMAGE_FIRST_PROPAGATION": {
      "depends_on": [
        "CONCEPT_AMBITION"
      ],
      "cost": "MEDIUM",
      "parallelizable": false,
      "contract": "Cover + Mid + Climax + wordless test"
    },
    "STORY_BUILD": {
      "depends_on": [
        "IMAGE_FIRST_PROPAGATION"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": false
    },
    "STORY_CRITIC": {
      "depends_on": [
        "STORY_BUILD"
      ],
      "cost": "EXPENSIVE",
      "parallel_group": "story_review"
    },
    "RECENT5_SEMANTIC": {
      "depends_on": [
        "STORY_BUILD"
      ],
      "cost": "EXPENSIVE",
      "parallel_group": "story_review"
    },
    "VISUAL_LOCK": {
      "depends_on": [
        "RESOLVED_FRAME_CONTRACT"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": false,
      "calibration_roles": [
        "ordinary_baseline",
        "worst_capture_condition",
        "first_major_anomaly",
        "high_impact_admission"
      ],
      "critic": "episodes/_system/visual_lock_v21.py",
      "calibration_count": 4
    },
    "PRODUCTION": {
      "depends_on": [
        "IMAGE_WAVES"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": true
    },
    "FRAME_REVIEW": {
      "depends_on": [
        "FAST_FRAME_SCOUT"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": false
    },
    "TEXT_RELEASE": {
      "depends_on": [
        "FRAME_REVIEW"
      ],
      "cost": "MEDIUM",
      "parallelizable": true
    },
    "PUBLISH_READY_GATE": {
      "depends_on": [
        "FINAL_CANDIDATE_SNAPSHOT"
      ],
      "cost": "CHEAP",
      "parallelizable": false
    },
    "DELIVERY": {
      "depends_on": [
        "PUBLISH_READY_GATE"
      ],
      "cost": "MEDIUM",
      "parallelizable": false,
      "runtime_optional": true,
      "snapshot_driven": true
    },
    "ENVIRONMENT_IMPACT_CONTRACT": {
      "depends_on": [
        "STORY_CRITIC",
        "RECENT5_SEMANTIC"
      ],
      "cost": "MEDIUM",
      "parallelizable": false,
      "evidence": "meta/story-gates.json#visual.environment_contract+frame_directives"
    },
    "RESOLVED_FRAME_CONTRACT": {
      "depends_on": [
        "ENVIRONMENT_IMPACT_CONTRACT"
      ],
      "cost": "CHEAP",
      "parallelizable": false,
      "derived_cache": true,
      "evidence": "meta/runtime/contracts/frame-contract-index.json"
    },
    "IMAGE_WAVES": {
      "depends_on": [
        "VISUAL_LOCK"
      ],
      "cost": "EXPENSIVE",
      "parallelizable": true,
      "max_parallel": 3,
      "adaptive_parallel": true,
      "fail_soft": true,
      "scheduler": "episodes/_system/image_scheduler.py"
    },
    "FAST_FRAME_SCOUT": {
      "depends_on": [
        "IMAGE_WAVES"
      ],
      "cost": "MEDIUM",
      "parallelizable": true,
      "risk_based": true,
      "final_pass_authority": false,
      "evidence": "meta/frame-scout-summary.json",
      "tool": "episodes/_system/fast_frame_scout.py"
    },
    "FINAL_CANDIDATE_SNAPSHOT": {
      "depends_on": [
        "TEXT_RELEASE"
      ],
      "cost": "CHEAP",
      "parallelizable": false,
      "derived_evidence": true,
      "evidence": "meta/final-candidate-snapshot.json",
      "tool": "episodes/_system/final_candidate_snapshot.py"
    }
  }
}

{
  "schema_version": 5,
  "module_version": "2.6.1",
  "platform_min_version": "2.6.0",
  "workflow_contract": "runtimes/workflow-contract.json",
  "name": "Story OS V2.6.1 Product-Runtime-First Multi-Runtime Contract",
  "state_source": "meta/episode-state.json",
  "creative_authority": "standards/制作规范_正式版.md",
  "routing_order": [
    "WORK",
    "CODEX",
    "WEB"
  ],
  "routing": {
    "CODEX": {
      "selection": "explicit_only",
      "target": "deterministic_full_auto_file_pipeline",
      "checkpoint": "repository",
      "orchestrator": "episodes/_system/workflow_runner.py",
      "compat_orchestrator": "episodes/_system/codex_auto_orchestrator.py",
      "image_backend": "episodes/_system/codex_subscription_image.py",
      "canvas_normalizer": "episodes/_system/canvas_normalize.py",
      "postflight_required": true,
      "production_complete_at": "PUBLISH_READY",
      "delivery_package": false,
      "final_zip": "not_required"
    },
    "WORK": {
      "selection": "default",
      "target": "full_auto_workspace_pipeline",
      "checkpoint": "workspace_and_repository_when_writable",
      "orchestrator": "episodes/_system/product_runtime_adapter.py",
      "critic_provenance": "WORK_ISOLATED",
      "image_backend": "codex_subscription_image_execution_only",
      "local_codex_spawn_allowed": false,
      "local_codex_image_spawn_allowed": true,
      "codex_image_scope": "image_generation_and_image_repair_only",
      "local_codex_fallback_allowed": false,
      "production_complete_at": "PUBLISH_READY",
      "delivery_package": "when_capable",
      "final_zip": "required_when_tools_allow"
    },
    "WEB": {
      "selection": "product_fallback",
      "target": "continuous_best_effort_with_resume",
      "checkpoint": "conversation_and_repository_when_writable",
      "orchestrator": "episodes/_system/product_runtime_adapter.py",
      "critic_provenance": "WEB_ISOLATED",
      "image_backend": "product_runtime_image",
      "local_codex_spawn_allowed": false,
      "local_codex_fallback_allowed": false,
      "production_complete_at": "PUBLISH_READY",
      "delivery_package": "when_capable",
      "final_zip": "best_effort_only_when_tools_allow"
    }
  },
  "common_rules": {
    "default_runtime": "WORK",
    "default_image_execution_runtime": "CODEX",
    "codex_image_controller_model": "gpt-5.6-luna",
    "codex_image_reasoning_effort": "medium",
    "codex_image_payload_model": "gpt-image-2",
    "codex_image_payload_quality": "high",
    "image_execution_runtime_env": "STORY_OS_IMAGE_RUNTIME",
    "image_execution_runtime_values": ["CODEX", "PRODUCT_RUNTIME", "AUTO"],
    "codex_image_execution_does_not_change_authoring_runtime": true,
    "codex_image_execution_must_not_run_full_auto": true,
    "local_codex_fallback": "explicit_only",
    "product_runtime_host_request": "meta/runtime/product-host-request.json",
    "product_runtime_host_request_history": "meta/runtime/host-requests/<request_id>.json",
    "product_review_request_pattern": "meta/runtime/reviews/<kind>-attempt-<n>-request.json",
    "product_host_checkpoint_status": "HOST_WAIT",
    "independent_critic_runtimes": ["WORK_ISOLATED", "WEB_ISOLATED", "CODEX_ISOLATED"],
    "work_web_must_not_spawn_local_codex_for_non_image_work": true,
    "product_image_missing_file_transport_must_pause_when_product_runtime_selected": true,
    "do_not_create_second_episode_stage": true,
    "do_not_duplicate_creative_rules_per_runtime": true,
    "explicit_full_auto_request_is_continuous_execution_authorization": true,
    "continuous_work_host_loop": true,
    "next_action_path": "meta/runtime/next-action.json",
    "next_action_is_derived_not_stage_authority": true,
    "preimage_compile_runtime_node": true,
    "preimage_compile_creates_no_episode_stage": true,
    "work_actual_pixel_review_after_visual_baseline": true,
    "work_actual_pixel_review_after_each_logical_batch": true,
    "do_not_claim_user_personally_reviewed_unseen_assets": true,
    "delegated_auto_review_is_not_direct_user_review": true,
    "delegated_approval_is_valid_when_continuous_execution_authorized": true,
    "calibration_before_batch": true,
    "visual_admission_before_batch": true,
    "max_content_repair_per_frame": 1,
    "reuse_locked_assets": true,
    "resource_selection_resolver_version": 3,
    "resource_selection_stale_before_image": "auto_rebuild_then_fail_closed",
    "canonical_episode_discovery": "episodes/_system/episode_discovery.py",
    "episode_discovery_excludes_internal_and_test_roots": true,
    "semantic_text_encoding_health_gate": "episodes/_system/text_encoding_health.py",
    "runtime_path_portability_guard": "episodes/_system/runtime_portability.py",
    "canonical_module_index": "episodes/_system/MODULE_INDEX.json",
    "minimal_edit_protocol": true,
    "stable_evidence_gate": "episodes/_system/evidence_gate.py",
    "worker_return_code_is_not_completion": true,
    "completion_states": [
      "COMPLETE",
      "PAUSED",
      "BLOCKED"
    ],
    "fresh_isolated_frame_semantic_critic": true,
    "sha_bound_frame_review_required": true,
    "release_must_include_frame_reviews": true,
    "minimal_closure_default": true,
    "incremental_closure": "episodes/_system/incremental_closure.py",
    "incremental_frame_review": "episodes/_system/incremental_frame_review.py",
    "local_media_workspace": "episodes/_system/media_workspace.py",
    "full_review_escalation_dirty_ratio": 0.25,
    "frozen_evidence_media_paths_immutable": true,
    "zip_is_delivery_adapter": true,
    "codex_zip_not_required_for_completion": true,
    "workflow_performance_required": true,
    "concept_ambition_gate_for_v21_new_episodes": true,
    "reality_limits_capture_not_concept": true,
    "default_image_model": "gpt-image-2",
    "default_image_quality": "high",
    "episode_ratio_applies_generation_through_release": true,
    "normalize_technical_failure_triggers_generation": false,
    "provider_capability_contract": "config/providers/index.json",
    "provider_exact_raw_canvas_guaranteed": false,
    "provider_receipt_required": true,
    "runtime_trace_enabled": true,
    "runtime_trace_stage_authority": false,
    "request_intent_resolver_enabled": true,
    "request_router_enabled": true,
    "route_decision_stage_authority": false,
    "batch_image_runtime_config": "config/agent_runtime/batch.json",
    "batch_image_runtime_supported": true,
    "batch_visual_lock_enabled": false,
    "batch_contract_is_derived_execution_evidence": true,
    "default_batch_images": 5,
    "batch_provider_probe": "lazy_first_real_batch",
    "batch_transport_failure_fallback": "single_frame_same_runtime_only",
    "deviation_high_min": 80,
    "criticality_high_min": 80,
    "high_high_requires_both": true,
    "image_provider_runtime": "config/providers/image-provider-runtime.json",
    "openai_native_n_max": 10,
    "openai_api_key_source": "environment_only",
    "provider_route_is_stage_authority": false,
    "distinct_frame_mapping_requires_review": true,
    "codex_subscription_runtime": "CODEX",
    "codex_subscription_logical_batch_config": "config/agent_runtime/codex-subscription-batch.json",
    "codex_logical_batch_size": 5,
    "codex_logical_batch_max_inflight_images": 3,
    "codex_logical_batch_adaptive_steps": [
      3,
      2,
      1
    ],
    "codex_logical_batch_requires_api_key": false,
    "codex_logical_batch_native_multi_image": false,
    "codex_logical_batch_single_http_request": false,
    "raw_runtime_logs_git_authority": false,
    "local_only_runtime_log_patterns": [
      "meta/image-workers/**",
      "meta/rolling-review-workers/**",
      "meta/scoped-workers/**",
      "meta/codex-auto-run.jsonl",
      "meta/runtime/trace-events.jsonl",
      "meta/workflow-run.jsonl"
    ]
  }
}

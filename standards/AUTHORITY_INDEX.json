  "rules": {
    "superseded_default_read": false,
    "unknown_versioned_standard_is_warning": true,
    "series_overlay_may_override_canonical": false,
    "state_source": "meta/episode-state.json",
    "default_visual_profile": {
      "id": "M00",
      "name": "MP4 × 网吧 × 流水席旧数码质感校准版",
      "profile_path": "standards/visual_profiles/M00_MP4_网吧_流水席_旧数码.json",
      "standard_path": "standards/风格锚点_MP4_网吧_流水席_旧数码_V1.2.md",
      "use_when_unspecified": true,
      "explicit_override_wins": true,
      "capture_physics_and_story_era_win_over_texture": true
    },
    "runtime_routing": {
      "contract": "runtimes/runtime-contract.json",
      "order": [
        "CODEX",
        "WORK",
        "WEB"
      ],
      "ask_user_to_choose": false,
      "second_stage_forbidden": true,
      "stable_evidence_gate": "episodes/_system/evidence_gate.py"
    },
    "capture_profile_registry": {
      "path": "standards/capture_profiles/index.json",
      "default_profile_id": "CP01",
      "capture_physics_over_texture": true
    },
    "story_regression_library": {
      "path": "standards/story_regressions/cases.json"
    },
    "episode_fingerprint": {
      "episode_path": "meta/episode-fingerprint.json",
      "account_registry": "reports/account-pattern-registry.json",
      "recent_compare_count": 5,
      "mechanism_veto": true
    },
    "codex_auto_orchestrator": {
      "path": "episodes/_system/codex_auto_orchestrator.py",
      "image_backend": "episodes/_system/codex_subscription_image.py",
      "approval_basis": "delegated_auto_review",
      "may_fake_user_approval": false
    },
    "delegated_approval": {
      "path": "episodes/_system/delegated_approval.py",
      "requires_continuous_execution_authorized": true,
      "may_fake_user_approval": false
    },
    "production_closure": {
      "orchestrator": "episodes/_system/codex_auto_orchestrator.py",
      "canvas_normalizer": "episodes/_system/canvas_normalize.py",
      "delivery": "episodes/_system/delegated_delivery.py",
      "completion_states": [
        "COMPLETE",
        "PAUSED",
        "BLOCKED"
      ]
    }
  }

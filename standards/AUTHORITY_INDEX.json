  "rules": {
    "superseded_default_read": false,
    "unknown_versioned_standard_is_warning": true,
    "series_overlay_may_override_canonical": false,
    "state_source": "meta/episode-state.json",
    "default_visual_profile": {
      "id": "M00",
      "name": "MP4 × 网吧 × 流水席旧数码质感校准版",
      "profile_path": "standards/visual_profiles/M00_MP4_网吧_流水席_旧数码.json",
      "standard_path": "standards/风格锚点_MP4_网吧_流水席_旧数码_V1.2.md",
      "use_when_unspecified": true,
      "explicit_override_wins": true,
      "capture_physics_and_story_era_win_over_texture": true
    },
    "runtime_routing": {
      "contract": "runtimes/runtime-contract.json",
      "order": [
        "CODEX",
        "WORK",
        "WEB"
      ],
      "ask_user_to_choose": false,
      "second_stage_forbidden": true,
      "stable_evidence_gate": "episodes/_system/evidence_gate.py"
    },
    "capture_profile_registry": {
      "path": "standards/capture_profiles/index.json",
      "default_profile_id": "CP01",
      "capture_physics_over_texture": true
    },
    "story_regression_library": {
      "path": "standards/story_regressions/cases.json"
    },
    "episode_fingerprint": {
      "episode_path": "meta/episode-fingerprint.json",
      "account_registry": "reports/account-pattern-registry.json",
      "recent_compare_count": 5,
      "mechanism_veto": true
    },
    "codex_auto_orchestrator": {
      "path": "episodes/_system/codex_auto_orchestrator.py",
      "image_backend": "episodes/_system/codex_subscription_image.py",
      "approval_basis": "delegated_auto_review",
      "may_fake_user_approval": false
    },
    "delegated_approval": {
      "path": "episodes/_system/delegated_approval.py",
      "requires_continuous_execution_authorized": true,
      "may_fake_user_approval": false
    },
    "production_closure": {
      "orchestrator": "episodes/_system/codex_auto_orchestrator.py",
      "canvas_normalizer": "episodes/_system/canvas_normalize.py",
      "delivery": "episodes/_system/delegated_delivery.py",
      "completion_states": [
        "COMPLETE",
        "PAUSED",
        "BLOCKED"
      ],
      "frame_semantic_review": "episodes/_system/frame_semantic_review.py"
    },
    "creative_enforcement": {
      "story_review": "episodes/_system/story_review.py",
      "story_review_evidence": "meta/story-semantic-review.json",
      "visual_review": "episodes/_system/visual_review.py",
      "visual_review_evidence": "meta/visual-profile-review.json",
      "subtitle_renderer": "episodes/_system/subtitle_layout.py",
      "subtitle_layout_evidence": "meta/subtitle-layout-audit.json",
      "new_state_forbidden": true,
      "frame_semantic_review": "episodes/_system/frame_semantic_review.py",
      "frame_semantic_review_summary": "meta/frame-semantic-review.json",
      "frame_semantic_review_dir": "meta/frame-reviews",
      "frame_semantic_audit": "meta/frame-semantic-audit.json"
    },
    "incremental_workspace": {
      "planner": "episodes/_system/incremental_closure.py",
      "frame_reviewer": "episodes/_system/incremental_frame_review.py",
      "media_workspace": "episodes/_system/media_workspace.py",
      "media_index": "meta/media-index.json",
      "dirty_ratio_full_escalation": 0.25,
      "new_state_forbidden": true,
      "frozen_evidence_media_paths_immutable": true
    },
    "release_preflight_guard": {
      "path": "episodes/_system/release_preflight.py",
      "recent5_evidence": "meta/recent5-review.json",
      "series_lock": "<series>/meta/series-lock.json",
      "series_binding": "meta/series-lock-binding.json",
      "release_semantic_review": "meta/release-semantic-review.json",
      "publish_compliance": "meta/publish-compliance.json",
      "new_state_forbidden": true,
      "series_continuity": "<series>/meta/series-continuity.json",
      "series_detection_mode": "explicit_marker_or_existing_lock_only",
      "sibling_episode_count_is_continuity_signal": false,
      "semantic_recent5_review": "meta/recent5-semantic-review.json",
      "semantic_recent5_critic_log": "meta/recent5-semantic-critic.jsonl",
      "semantic_recent5_min_contract": "2.0.3.6",
      "semantic_scoring_policy": "max(exact_string,semantic_equivalence)",
      "critic_may_assign_numeric_similarity_score": false
    }
  }
}

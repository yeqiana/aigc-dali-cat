{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story OS V2.5 Propagation Core",
  "type": "object",
  "required": [
    "retell_sentence",
    "protagonist_action",
    "abnormal_response",
    "consequence",
    "response_latency",
    "visual_causality",
    "retellable_in_10s",
    "social_send_impulse",
    "trigger_frame",
    "response_frame",
    "payoff_frame",
    "late_trigger_exception_reason",
    "surface_copy_guard"
  ],
  "properties": {
    "retell_sentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "protagonist_action": {
      "type": "string",
      "minLength": 1
    },
    "abnormal_response": {
      "type": "string",
      "minLength": 1
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    },
    "response_latency": {
      "enum": [
        "immediate",
        "short",
        "delayed_but_direct"
      ]
    },
    "visual_causality": {
      "enum": [
        "strong",
        "medium",
        "weak"
      ]
    },
    "retellable_in_10s": {
      "type": "boolean"
    },
    "social_send_impulse": {
      "enum": [
        "strong",
        "medium",
        "weak"
      ]
    },
    "trigger_frame": {
      "type": "integer",
      "minimum": 1
    },
    "response_frame": {
      "type": "integer",
      "minimum": 1
    },
    "payoff_frame": {
      "type": "integer",
      "minimum": 1
    },
    "late_trigger_exception_reason": {
      "type": "string"
    },
    "surface_copy_guard": {
      "type": "object",
      "required": [
        "structural_reference_only",
        "copied_surface_elements"
      ],
      "properties": {
        "structural_reference_only": {
          "type": "boolean"
        },
        "copied_surface_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

  "rules": {
    "superseded_default_read": false,
    "unknown_versioned_standard_is_warning": true,
    "series_overlay_may_override_canonical": false,
    "state_source": "meta/episode-state.json",
    "default_visual_profile": {
      "id": "M00",
      "name": "现实生活纪实母版",
      "profile_path": "standards/visual_profiles/M00_MP4_网吧_流水席_旧数码.json",
      "standard_path": "standards/风格锚点_MP4_网吧_流水席_旧数码_V1.2.md",
      "use_when_unspecified": true,
      "explicit_override_wins": true,
      "capture_physics_and_story_era_win_over_texture": true
    },
    "image_runtime_defaults": {
      "model": "gpt-image-2",
      "quality": "high",
      "aspect_ratio_source": "episode_locked",
      "style_parameter": "none",
      "seed": "none"
    },
    "normalize_policy": {
      "id": "NP01",
      "enabled": true,
      "preserve_raw": true,
      "final_format": "PNG",
      "resize_algorithm": "Lanczos",
      "default_crop": "forbidden",
      "imageops_fit": "exception_only",
      "automatic_ratio_delta_max": 0.01,
      "review_ratio_delta_max": 0.03,
      "reject_above": 0.03,
      "noop_when_exact_match": true,
      "technical_failure_triggers_generation": false
    },
    "runtime_routing": {
      "contract": "runtimes/runtime-contract.json",
      "order": [
        "CODEX",
        "WORK",
        "WEB"
      ],
      "ask_user_to_choose": false,
      "second_stage_forbidden": true,
      "stable_evidence_gate": "episodes/_system/evidence_gate.py"
    },
    "capture_profile_registry": {
      "path": "standards/capture_profiles/index.json",
      "default_profile_id": "CP01",
      "capture_physics_over_texture": true
    },
    "story_regression_library": {
      "path": "standards/story_regressions/cases.json"
    },
    "episode_fingerprint": {
      "episode_path": "meta/episode-fingerprint.json",
      "account_registry": "reports/account-pattern-registry.json",
      "recent_compare_count": 5,
      "mechanism_veto": true
    },
    "codex_auto_orchestrator": {
      "path": "episodes/_system/codex_auto_orchestrator.py",
      "image_backend": "episodes/_system/codex_subscription_image.py",
      "approval_basis": "delegated_auto_review",
      "may_fake_user_approval": false
    },
    "delegated_approval": {
      "path": "episodes/_system/delegated_approval.py",
      "requires_continuous_execution_authorized": true,
      "may_fake_user_approval": false
    },
    "production_closure": {
      "orchestrator": "episodes/_system/workflow_runner.py",
      "canvas_normalizer": "episodes/_system/canvas_normalize.py",
      "delivery": "episodes/_system/delegated_delivery.py",
      "completion_states": [
        "COMPLETE",
        "PAUSED",
        "BLOCKED"
      ],
      "frame_semantic_review": "episodes/_system/frame_semantic_review.py",
      "compat_orchestrator": "episodes/_system/codex_auto_orchestrator.py"
    },
    "creative_enforcement": {
      "story_review": "episodes/_system/story_review.py",
      "story_review_evidence": "meta/story-semantic-review.json",
      "visual_review": "episodes/_system/visual_review.py",
      "visual_review_evidence": "meta/visual-profile-review.json",
      "subtitle_renderer": "episodes/_system/subtitle_layout.py",
      "subtitle_layout_evidence": "meta/subtitle-layout-audit.json",
      "new_state_forbidden": true,
      "frame_semantic_review": "episodes/_system/frame_semantic_review.py",
      "frame_semantic_review_summary": "meta/frame-semantic-review.json",
      "frame_semantic_review_dir": "meta/frame-reviews",
      "frame_semantic_audit": "meta/frame-semantic-audit.json"
    },
    "incremental_workspace": {
      "planner": "episodes/_system/incremental_closure.py",
      "frame_reviewer": "episodes/_system/incremental_frame_review.py",
      "media_workspace": "episodes/_system/media_workspace.py",
      "media_index": "meta/media-index.json",
      "dirty_ratio_full_escalation": 0.25,
      "new_state_forbidden": true,
      "frozen_evidence_media_paths_immutable": true
    },
    "release_preflight_guard": {
      "path": "episodes/_system/release_preflight.py",
      "recent5_evidence": "meta/recent5-review.json",
      "series_lock": "<series>/meta/series-lock.json",
      "series_binding": "meta/series-lock-binding.json",
      "release_semantic_review": "meta/release-semantic-review.json",
      "publish_compliance": "meta/publish-compliance.json",
      "new_state_forbidden": true,
      "series_continuity": "<series>/meta/series-continuity.json",
      "series_detection_mode": "explicit_marker_or_existing_lock_only",
      "sibling_episode_count_is_continuity_signal": false,
      "semantic_recent5_review": "meta/recent5-semantic-review.json",
      "semantic_recent5_critic_log": "meta/recent5-semantic-critic.jsonl",
      "semantic_recent5_min_contract": "2.0.3.6",
      "semantic_scoring_policy": "max(exact_string,semantic_equivalence)",
      "critic_may_assign_numeric_similarity_score": false
    },
    "workflow_engine": {
      "contract": "runtimes/workflow-contract.json",
      "runner": "episodes/_system/workflow_runner.py",
      "episode_stage_source": "meta/episode-state.json"
    },
    "concept_ambition": {
      "standard": "standards/选题野心与图像传播力规范_V1.0.md",
      "tool": "episodes/_system/concept_ambition.py",
      "candidates": "meta/concept-candidates.json",
      "review": "meta/concept-ambition-review.json",
      "min_candidates": 8,
      "max_candidates": 12,
      "min_selected_voltage": 80,
      "min_high_ambition_candidates": 3,
      "required_for_contract_min": "2.1.0"
    },
    "environment_contract": {
      "tool": "episodes/_system/environment_contract.py",
      "authority_path": "meta/story-gates.json#visual.environment_contract",
      "frame_directives_path": "meta/story-gates.json#visual.frame_directives",
      "required_for_contract_min": "2.1.0",
      "independent_weather_file_forbidden": true
    },
    "resolved_frame_contract": {
      "tool": "episodes/_system/frame_contract.py",
      "cache_root": "meta/runtime/contracts/frames",
      "index": "meta/runtime/contracts/frame-contract-index.json",
      "authority_sources": [
        "Story",
        "Storyboard",
        "meta/story-gates.json",
        "Visual Profile",
        "approved references"
      ],
      "required_for_contract_min": "2.1.0",
      "cache_is_authority": false
    },
    "visual_lock_v21": {
      "tool": "episodes/_system/visual_lock_v21.py",
      "review_compat_entry": "episodes/_system/visual_review.py",
      "roles": [
        "ordinary_baseline",
        "worst_capture_condition",
        "first_major_anomaly",
        "high_impact_admission"
      ],
      "required_when_calibration_policy": "four_admission_v21"
    },
    "image_scheduler": {
      "tool": "episodes/_system/image_scheduler.py",
      "queue": "meta/production-queue.json",
      "max_parallel": 3,
      "adaptive": true,
      "ledger_writer": "scheduler_main_thread_only",
      "fail_soft": true
    },
    "fast_frame_scout": {
      "tool": "episodes/_system/fast_frame_scout.py",
      "summary": "meta/frame-scout-summary.json",
      "final_pass_authority": false
    },
    "final_candidate_snapshot": {
      "tool": "episodes/_system/final_candidate_snapshot.py",
      "path": "meta/final-candidate-snapshot.json",
      "snapshot_is_authority": false,
      "delivery_must_consume": true
    },
    "v21_migration": {
      "tool": "episodes/_system/migrate_v21.py",
      "default": "read_only",
      "legacy_evidence_backfill": false
    },
    "v21_regression": {
      "tool": "episodes/_system/regression_matrix_v21.py",
      "report": "reports/story-os-v21-regression-matrix.json"
    },
    "workflow_observability": {
      "tool": "episodes/_system/workflow_observability.py",
      "path": "meta/workflow-observability.json",
      "stage_authority": false
    },
    "post_publish": {
      "tool": "episodes/_system/post_publish_review.py",
      "publish_event": "meta/publish-event.json",
      "metrics": "meta/post-publish-metrics.json",
      "review": "meta/post-publish-review.json",
      "data_review_state": "meta/data-review-state.json",
      "learning": "meta/next-story-learning.json",
      "required_checkpoint_for_data_reviewed": "48h",
      "mutate_release_manifest_after_snapshot": false
    },
    "account_learning_index": {
      "tool": "episodes/_system/account_learning_index.py",
      "path": "reports/account-learning-index.json",
      "creative_authority": false
    },
    "provider_capability_contract": {
      "registry": "config/providers/index.json",
      "receipt_dir": "meta/provider-receipts",
      "receipt_is_authority": false
    },
    "agent_runtime_v230": {
      "trace_config": "config/agent_runtime/trace.json",
      "intent_config": "config/agent_runtime/intent.json",
      "router_config": "config/agent_runtime/router.json",
      "route_decision": "meta/runtime-route.json",
      "stage_source": "meta/episode-state.json"
    },
    "batch_image_runtime_v240": {
      "config": "config/agent_runtime/batch.json",
      "visual_lock_batch_enabled": false,
      "images_per_batch": 5,
      "stage_source": "meta/episode-state.json",
      "batch_contract_is_authority": false
    },
    "image_provider_runtime_v241": {
      "config": "config/providers/image-provider-runtime.json",
      "preferred_provider_when_api_key_present": "openai_images_api",
      "native_n_max": 10,
      "secret_persistence_forbidden": true,
      "stage_source": "meta/episode-state.json"
    }
  }
}
